# Email Configuration for TrustEd Certificate Verification System
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Example with actual Gmail account:
# EMAIL_USER=trusted.verification@gmail.com
# EMAIL_PASS=abcd efgh ijkl mnop

# Note: For Gmail, use App Password instead of regular password
# Enable 2-factor authentication and generate App Password
