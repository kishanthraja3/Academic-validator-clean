# Certificate and key files (keep structure but ignore actual files)
# backend/certificate_validator/keys/*.pem - REMOVED: Allow keys for signature pipeline
# backend/certificate_validator/keys/*.key - REMOVED: Allow keys for signature pipeline
backend/certificate_validator/signed/*.pdf
backend/certificate_validator/signed/*.sig.json
backend/certificate_validator/cert_pdfs/*.pdf
backend/certificate_validator/legacy_pdfs/*.pdf
backend/certificate_validator/qr_pdf_output/*.pdf

# Keep blockchain folder structure but ignore large files
blockchain/fabric/bin/
blockchain/fabric/config/
blockchain/fabric/scripts/
blockchain/venv/

# Keep blockchain files but ignore generated content
# blockchain/fabric/chaincode/ - REMOVED: Allow full chaincode directory

# Ignore entire fabric-samples folder (too large for git)
blockchain/fabric-samples/

# Docker volumes and generated blockchain data
blockchain/data/
# blockchain/keys/ - REMOVED: Allow keys for signature pipeline
blockchain/organizations/

